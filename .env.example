# NOTE: The actual environment configuration lives in data/config/.env
# This file is provided as a root-level reference.
# Refer to data/config/.env.example for the active template.

PORT=3000
NODE_ENV=development
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
AUTHORIZED_USERS=123456789,987654321
DATABASE_URL="file:./data/sell_helper.db"
GEMINI_API_KEY=your_gemini_api_key_here
# Public URL for web preview buttons in Telegram (e.g., https://yourdomain.com or ngrok tunnel)
# Required for clickable Telegram inline URL buttons (Telegram rejects localhost URLs)
WEB_BASE_URL=http://localhost:3000

