# Application Configuration
PORT=3000
NODE_ENV=development

# Telegram Bot Credentials
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Access Control Whitelist (Comma-separated Telegram User IDs)
AUTHORIZED_USERS=123456789,987654321

# SQLite Database Connection URL
DATABASE_URL="file:../sell_helper.db"

# Google Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here
# Public URL for web preview buttons in Telegram (e.g., https://yourdomain.com or ngrok tunnel)
# Required for clickable Telegram inline URL buttons (Telegram rejects localhost URLs)
WEB_BASE_URL=http://localhost:3000

