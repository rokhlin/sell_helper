# Application Configuration
PORT=3000
NODE_ENV=development

# Telegram Bot Credentials
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Access Control Whitelist (Comma-separated Telegram User IDs)
AUTHORIZED_USERS=123456789,987654321

# SQLite Database Connection URL
DATABASE_URL="file:../sell_helper.db"

# Google Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here
# Web preview URL accessible by clients (e.g. LAN http://192.168.8.213:3021, domain, or reverse proxy)
# Required so Telegram links and buttons open properly from browsers in the local network or internet
WEB_BASE_URL=http://192.168.8.213:3021

